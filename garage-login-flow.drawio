                <mxCell id="llApp" value="Застосунок" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
                    <mxGeometry x="280" y="60" width="160" height="1200" as="geometry" />
                </mxCell>
                <mxCell id="llTg" value="Telegram" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
                    <mxGeometry x="520" y="60" width="160" height="1200" as="geometry" />
                </mxCell>
                <mxCell id="llApi" value="API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
                    <mxGeometry x="760" y="60" width="160" height="1200" as="geometry" />
                </mxCell>
                <mxCell id="llDb" value="БД" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
                    <mxGeometry x="1020" y="60" width="160" height="1200" as="geometry" />
                </mxCell>

                <mxCell id="frameA" value="&lt;b&gt;opt&lt;/b&gt;&amp;nbsp; бот ще не активований — разово на життя акаунта" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="80" y="120" width="1060" height="500" as="geometry" />
                </mxCell>

                <mxCell id="m1" value="1. «Вперше тут? Активувати бота»" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="120" y="160" as="sourcePoint" />
                        <mxPoint x="360" y="160" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m2" value="2. відкриває t.me/&amp;lt;bot&amp;gt; — без параметрів" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="360" y="206" as="sourcePoint" />
                        <mxPoint x="600" y="206" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m3" value="3. /start" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="252" as="sourcePoint" />
                        <mxPoint x="840" y="252" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m4" value="4. кнопка «Поділитися номером» (request_contact)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="298" as="sourcePoint" />
                        <mxPoint x="600" y="298" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m5" value="5. показує кнопку" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="344" as="sourcePoint" />
                        <mxPoint x="120" y="344" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m6" value="6. тисне кнопку" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="120" y="390" as="sourcePoint" />
                        <mxPoint x="600" y="390" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m7" value="7. Contact {phone_number, user_id}" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="436" as="sourcePoint" />
                        <mxPoint x="840" y="436" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m8" value="8. contact.user_id == message.from.id" style="html=1;align=left;verticalAlign=bottom;endArrow=block;endSize=8;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="472" as="sourcePoint" />
                        <mxPoint x="842" y="500" as="targetPoint" />
                        <Array as="points">
                            <mxPoint x="960" y="472" />
                            <mxPoint x="960" y="500" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m9" value="9. User {telegramId, phone}" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="546" as="sourcePoint" />
                        <mxPoint x="1100" y="546" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m10" value="10. «Готово. Введіть свій номер у застосунку»" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="592" as="sourcePoint" />
                        <mxPoint x="600" y="592" as="targetPoint" />
                    </mxGeometry>
                </mxCell>

                <mxCell id="frameB" value="&lt;b&gt;вхід&lt;/b&gt;&amp;nbsp; щоразу — і одразу після активації, і через місяць, без виходу в чат" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="80" y="650" width="1060" height="590" as="geometry" />
                </mxCell>

                <mxCell id="m11" value="11. вводить номер телефону" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="120" y="700" as="sourcePoint" />
                        <mxPoint x="360" y="700" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m12" value="12. POST /auth/request-code {phone}" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="360" y="746" as="sourcePoint" />
                        <mxPoint x="840" y="746" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m13" value="13. SELECT user WHERE phone = @phone" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="792" as="sourcePoint" />
                        <mxPoint x="1100" y="792" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m14" value="14. login_code {userId, codeHash, expiresAt, attempts = 0}" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="838" as="sourcePoint" />
                        <mxPoint x="1100" y="838" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m15" value="15. sendMessage(telegramId, код) — бот пише першим" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="884" as="sourcePoint" />
                        <mxPoint x="600" y="884" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m16" value="16. push із кодом + «не передавайте нікому»" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="600" y="930" as="sourcePoint" />
                        <mxPoint x="120" y="930" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m17" value="17. вводить код (або «Вставити» з буфера)" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="120" y="976" as="sourcePoint" />
                        <mxPoint x="360" y="976" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m18" value="18. POST /auth/verify {phone, code}" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="360" y="1022" as="sourcePoint" />
                        <mxPoint x="840" y="1022" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m19" value="19. UPDATE login_code SET consumed_at ... RETURNING user_id" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;strokeWidth=2;strokeColor=#b85450;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="1068" as="sourcePoint" />
                        <mxPoint x="1100" y="1068" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m20" value="20. User.refreshTokenHash ← новий" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="1114" as="sourcePoint" />
                        <mxPoint x="1100" y="1114" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m21" value="21. access-JWT + refresh" style="html=1;verticalAlign=bottom;endArrow=open;endSize=10;startSize=8;dashed=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="1160" as="sourcePoint" />
                        <mxPoint x="360" y="1160" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                <mxCell id="m22" value="22. «ви увійшли в GarageOS»" style="html=1;verticalAlign=bottom;endArrow=block;endSize=8;startSize=8;dashed=1;" edge="1" parent="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="840" y="1206" as="sourcePoint" />
                        <mxPoint x="600" y="1206" as="targetPoint" />
                    </mxGeometry>
                </mxCell>

                <mxCell id="open" value="&lt;b&gt;Ухвалено: кажемо правду&lt;/b&gt;&lt;br&gt;Крок 12 на невідомий номер віддає 404 «бот не активований або заблокований», а не ту саму відповідь, що при успіху. Слабкий оракул «чи є цей номер у системі» прийнятніший за тупик, у якому новачок чекає коду, якого не буде. Той самий текст — і на недосяжний чат." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="1210" y="100" width="350" height="136" as="geometry" />
                </mxCell>
                <mxCell id="n1" value="Апдейти бота: getUpdates локально, бо GarageOSWeb ще нікуди не задеплоєний; вебхук із secret_token у продакшні." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="1210" y="250" width="350" height="76" as="geometry" />
                </mxCell>
                <mxCell id="n2" value="Єдине місце, де номер стає засвідченим — крок 7, від Telegram. Більше його ніхто не підтверджує й не перезаписує." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="1210" y="420" width="350" height="86" as="geometry" />
                </mxCell>
                <mxCell id="n3" value="Номер із кроку 11 — ключ пошуку, не заява про особу: він лише знаходить рядок, нічого не записує й нічого не звязує. Ліміт частоти — за номером і за IP, інакше чужому Telegram можна сипати кодами." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="1210" y="700" width="350" height="116" as="geometry" />
                </mxCell>
                <mxCell id="n4" value="Один активний код на людину: крок 14 інвалідує попередній. TTL 2–5 хвилин, у БД — хеш, не код." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="1210" y="836" width="350" height="76" as="geometry" />
                </mxCell>
                <mxCell id="n5" value="Номер відомий ще до перевірки, тож рядок коду знаходиться завжди — і невдала спроба інкрементує attempts. Після 5 код мертвий. Саме цього лічильника не було, коли код видавався в чаті без номера." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="1210" y="1040" width="350" height="116" as="geometry" />
                </mxCell>
                <mxCell id="n6" value="Знайти, витратити й віддати user_id — одним стейтментом. Читання плюс запис тут створило б гонку, у якій два запити отримали б одну сесію." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=2;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="1210" y="1176" width="350" height="86" as="geometry" />
                </mxCell>

            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
