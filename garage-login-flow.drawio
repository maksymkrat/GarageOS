<mxfile host="65bd71144e">
    <diagram name="Login: bot activation, then phone and code" id="garageLogin0004">
        <mxGraphModel dx="2352" dy="3096" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />

                <mxCell id="title" value="&lt;b&gt;Вхід: активація бота разово, далі номер і код&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
